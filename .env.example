# Copy to .env.local and fill in.

# Required: speech-to-text, vision answers and text-to-speech
OPENAI_API_KEY=

# Optional model overrides
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=nova

# Optional: waitlist storage on Vercel (Upstash Redis via Vercel Marketplace).
# Without these, signups are saved to data/waitlist.json locally.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
